[Unit]
Description=Embedded Power Gateway Service
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/bin/power-gateway
Restart=on-failure
RestartSec=3
WatchdogSec=10
StandardOutput=journal
StandardError=journal
User=root

[Install]
WantedBy=multi-user.target
